# Local-only mode: no token needed. AGENTDASHBOARD_HOST is ignored without a token.
AGENTDASHBOARD_TOKEN=
AGENTDASHBOARD_PORT=4317

# For network mode, set a generated secret of at least 24 characters above.
# Network mode binds to all interfaces by default; uncomment to restrict it.
# AGENTDASHBOARD_HOST=127.0.0.1
