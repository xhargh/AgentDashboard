[Unit]
Description=AgentDashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/AgentDashboard
ExecStart=/usr/bin/node %h/AgentDashboard/src/server.js
EnvironmentFile=%h/.config/agentdashboard/environment
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
