FROM rust:1.90-bookworm AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl file libayatana-appindicator3-dev librsvg2-dev \
    libssl-dev libwebkit2gtk-4.1-dev libxdo-dev libgtk-3-dev patchelf \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src/desktop/src-tauri
COPY desktop/src-tauri ./
COPY public /src/public
RUN mkdir -p icons && python3 -c 'import struct,zlib; p=b"\x00\x00\x00\x00\x00"; chunk=lambda t,d: struct.pack(">I",len(d))+t+d+struct.pack(">I",zlib.crc32(t+d)&0xffffffff); open("icons/icon.png","wb").write(b"\x89PNG\r\n\x1a\n"+chunk(b"IHDR",struct.pack(">2I5B",1,1,8,6,0,0,0))+chunk(b"IDAT",zlib.compress(p))+chunk(b"IEND",b""))'
RUN cargo install tauri-cli --version '=2.12.2' --locked
RUN cargo tauri build --no-bundle -- --locked \
    && install -D target/release/agent-dashboard /out/AgentDashboard

FROM scratch AS artifact
COPY --from=build /out/AgentDashboard /AgentDashboard
